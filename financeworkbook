  figure.mock { margin: 18px 0; text-align:center; }
  figure.mock img { max-width: 100%; border:1px solid var(--line); border-radius: 8px; }
  figure.mock figcaption { font-size: 12.5px; color: var(--mid); font-family: Arial, sans-serif; margin-top: 6px; font-style: italic; }
  .datafiles { background:#FFF9EC; border:1px solid var(--accent); border-radius: 10px; padding: 14px 20px; margin: 24px 0; font-family: Arial, sans-serif; font-size: 14.5px; }
  footer { text-align:center; color: var(--mid); font-family: Arial, sans-serif; font-size: 13px; padding: 30px; border-top: 1px solid var(--line); }

  details.activity { background: var(--card); border:1px solid var(--line); border-radius: 10px; margin: 14px 0; overflow:hidden; }
  details.activity[open] { box-shadow: 0 4px 16px rgba(27,67,50,.07); }
  summary { list-style:none; cursor:pointer; display:flex; align-items:center; gap: 14px; padding: 16px 20px; font-family: Arial, sans-serif; }
  summary::-webkit-details-marker { display:none; }
  .actnum { background: var(--dark); color:#fff; font-weight:bold; border-radius: 8px; padding: 4px 10px; font-size: 14px; }
  .acttitle { font-weight: bold; color:#22302A; flex:1; font-size: 16px; }

<style>
  :root { --dark:#1B4332; --mid:#4F6F52; --bg:#FAFAF8; --accent:#B08D57; --card:#FFFFFF; --line:#DDE5DE; }
  * { box-sizing: border-box; }
  body { margin:0; font-family: Georgia, 'Times New Roman', serif; background: var(--bg); color:#22302A; }
  header { background: var(--dark); color:#fff; padding: 56px 24px 44px; text-align:center; }
  header .tag { letter-spacing: 3px; font-size: 13px; color:#9FB8A8; font-family: Arial, sans-serif; }
  header h1 { margin: 12px 0 6px; font-size: 42px; }
  header p.sub { color:#CADCFC; font-style: italic; margin: 0 0 18px; }
  header p.byline { color:#9FB8A8; font-family: Arial, sans-serif; font-size: 14px; margin: 0; }
  .progresswrap { max-width: 860px; margin: -24px auto 0; padding: 0 24px; }
  .progresscard { background: var(--card); border:1px solid var(--line); border-radius: 12px; padding: 18px 22px; box-shadow: 0 4px 14px rgba(27,67,50,.08); font-family: Arial, sans-serif; }

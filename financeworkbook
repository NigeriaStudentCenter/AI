  details.done summary .acttitle { color: var(--mid); }
  .inner { padding: 4px 24px 24px; border-top: 1px solid var(--line); }
  .inner h4 { color: var(--dark); font-family: Arial, sans-serif; letter-spacing: .5px; font-size: 14px; text-transform: uppercase; margin: 22px 0 8px; }
  .inner ol li, .inner ul li { margin: 8px 0; line-height: 1.5; }
  .objective, .tools { line-height: 1.55; }
  .checkpoint { list-style:none; padding-left: 0; }
